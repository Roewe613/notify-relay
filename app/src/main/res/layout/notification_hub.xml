<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/notification_hub_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/hub_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">_"
            android:textColor="#42D6FF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:paddingEnd="8dp" />
        <TextView
            android:id="@+id/hub_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NOTIFY-HUB"
            android:textColor="#83E8FF"
            android:textStyle="bold"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/hub_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#39D98A"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/hub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/hub_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#BED5EE"
        android:textSize="13sp"
        android:maxLines="4"
        android:ellipsize="end" />
</LinearLayout>
